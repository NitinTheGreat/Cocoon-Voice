# livekit-voice settings. Copy to .env (same folder). Loaded from this folder regardless of cwd.

# LiveKit Cloud project (the browser client must use the SAME project). From the project's Settings > Keys.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicit dispatch name. Browser/Console/API dispatch must use exactly this name.
COCOON_AGENT_NAME=cocoon-voice
# Worker health endpoint (GET / -> "OK", GET /worker -> JSON). Must not clash with 8000 (backend) or 8010 (mock).
COCOON_HEALTH_HOST=127.0.0.1
COCOON_HEALTH_PORT=8081

# Backend: langgraph-agent (http://127.0.0.1:8000) or the mock backend (http://127.0.0.1:8010).
# A worker hosted in the cloud cannot reach "localhost" on a laptop; use a reachable URL there.
COCOON_BACKEND_URL=http://127.0.0.1:8000
# Must equal COCOON_SERVICE_TOKEN in langgraph-agent/.env
COCOON_SERVICE_TOKEN=dev-local-change-me
COCOON_BACKEND_REQUEST_TIMEOUT=10
COCOON_BACKEND_CONNECT_TIMEOUT=3
COCOON_BACKEND_MAX_ATTEMPTS=4
COCOON_TURN_DEADLINE_SECONDS=30

# LiveKit Inference models (billed to the LiveKit Cloud project; no separate provider keys).
COCOON_STT_MODEL=assemblyai/universal-3-5-pro
COCOON_STT_LANGUAGE=en
COCOON_TTS_MODEL=fishaudio/s2.1-pro
COCOON_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

COCOON_DEFAULT_MACHINE_ID=cat-320-demo
COCOON_EVENT_POLL_INTERVAL=1.0
COCOON_EVENT_POLL_MAX_BACKOFF=30
COCOON_ANNOUNCEMENT_QUIET_WAIT_SECONDS=4
COCOON_ANNOUNCEMENT_PLAYOUT_TIMEOUT=30

# Mock backend (python -m cocoon_voice.mock_backend)
COCOON_MOCK_BACKEND_PORT=8010
COCOON_MOCK_SLOW_SECONDS=3
