# Cocoon voice worker (livekit-voice) — the requested env.example file.
# Copy to .env in this folder (livekit-voice/.env). It is loaded from here regardless of the working
# directory. Keep secrets only in .env (git-ignored); leave every secret below blank in this file.

# Required: LiveKit Cloud project credentials (Cloud dashboard > Settings > API keys).
# The browser (Agent Console / Playground) must use this SAME project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Explicit dispatch name; dispatch/console must use exactly this. (Replaces deprecated COCOON_AGENT_NAME.)
LIVEKIT_AGENT_NAME=cocoon-voice
# Worker health endpoint (SDK built-in): GET / -> OK, GET /worker -> JSON. Not 8000 (backend) or 8010 (mock).
COCOON_HEALTH_HOST=127.0.0.1
COCOON_HEALTH_PORT=8081

# Required: direct provider keys (not LiveKit Inference).
# AssemblyAI: https://www.assemblyai.com/app/api-keys  (streaming STT)
ASSEMBLYAI_API_KEY=
# Cartesia: https://play.cartesia.ai/keys  (streaming TTS)
CARTESIA_API_KEY=
# access_token (default): the worker mints a 1-hour TTS access token from the key and refreshes it;
# Cartesia rejected our raw keys on /tts/* with 401 while accepting minted tokens (see README).
# api_key: send the raw key directly (use only if python -m cocoon_voice.doctor shows cartesia_raw_key PASS).
CARTESIA_AUTH=access_token

# Required non-secret IDs (defaults verified against livekit-plugins 1.8.2 and provider docs; see README)
ASSEMBLYAI_MODEL=universal-3-5-pro
CARTESIA_MODEL=sonic-3
# Plugin default/documented Cartesia voice; `python -m cocoon_voice.doctor` prints its name once a key is set.
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
# Only "en" is accepted in this phase (Hindi/Hinglish not validated for the chosen STT+TTS).
VOICE_LANGUAGE=en

# Vertex AI: uses existing Application Default Credentials (gcloud auth application-default login).
# No Gemini API key, no GOOGLE_API_KEY/GEMINI_API_KEY, no GOOGLE_APPLICATION_CREDENTIALS path here.
GOOGLE_CLOUD_PROJECT=orbit-507316
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Measured 2026-09-23 on Vertex global: warm TTFT p50 738 ms with thinking off (see docs/voice-latency-report.md)
VERTEX_MODEL=gemini-2.5-flash
# minimal = lowest supported thinking (2.5-flash: thinking_budget=0; gemini-3: thinking_level=minimal)
VERTEX_THINKING=minimal
VERTEX_TEMPERATURE=0.6
VERTEX_MAX_OUTPUT_TOKENS=220

# This phase implements standalone_vertex; remote_langgraph is a future integration (rejected now).
VOICE_BRAIN=standalone_vertex
# development | production (production rejects transcript wake, degraded audio, preemptive, transcript logs)
VOICE_PROFILE=development
VOICE_GREETING=Hi, I'm Cat, your Cocoon assistant.

# Wake mode:
#   transcript       = STT always on; "Hey Cat" matched in the transcript (idle room audio is billed by AssemblyAI)
#   livekit_wakeword = acoustic keyword spotting with a livekit-wakeword .onnx (open source, no key; see wakeword/README.md)
#   porcupine        = acoustic keyword spotting with Picovoice (needs a Picovoice AccessKey)
WAKE_MODE=transcript
WAKE_PHRASE=Hey Cat
WAKE_ACTIVE_TIMEOUT_SECONDS=45
WAKE_DEBOUNCE_SECONDS=2
# Ignore wake phrases heard while (or this soon after) Cat itself is speaking
WAKE_ECHO_GUARD_MS=600

# Required only for WAKE_MODE=livekit_wakeword (train hey_cat.onnx: wakeword/README.md).
# To test the acoustic path before training: tests/fixtures/wakeword/hey_livekit.onnx with WAKE_PHRASE=Hey LiveKit
LIVEKIT_WAKEWORD_MODEL_PATH=
LIVEKIT_WAKEWORD_THRESHOLD=0.7
LIVEKIT_WAKEWORD_HOP_MS=160
# Shared by both acoustic modes: audio kept from before the detection, and wait before a wake-only "I'm listening."
WAKE_PREROLL_MS=600
WAKE_ONLY_ACK_WAIT_MS=900

# Required only for WAKE_MODE=porcupine
# Picovoice Console: https://console.picovoice.ai/ (AccessKey + custom "Hey Cat" keyword for your platform)
PICOVOICE_ACCESS_KEY=
# Path to the downloaded .ppn (e.g. keywords/hey-cat_en_windows_v4_0_0.ppn); relative paths = this folder
PORCUPINE_KEYWORD_PATH=
PORCUPINE_SENSITIVITY=0.5

# Noise: krisp = LiveKit Cloud Krisp in the worker. voice_isolation = Krisp VIVA (primary speaker, extra cost);
# noise_suppression = Krisp NC (included with LiveKit Cloud). Do not also enable Krisp in the browser.
NOISE_CANCELLATION=krisp
NOISE_PROFILE=voice_isolation
KRISP_SUPPRESSION_LEVEL=75
# true only for local development without Krisp; reported loudly as DEGRADED, rejected in production
ALLOW_DEGRADED_AUDIO=false
PREEMPTIVE_GENERATION=false
THINKING_CUE_ENABLED=true
THINKING_CUE_DELAY_MS=1200

# Turn-taking (AssemblyAI endpointing is the single end-of-turn authority)
ASSEMBLYAI_MIN_TURN_SILENCE_MS=160
ASSEMBLYAI_MAX_TURN_SILENCE_MS=1400
ASSEMBLYAI_KEYTERMS=Cocoon,Caterpillar,CAT,Hey Cat,excavator,wheel loader,dozer,backhoe,hydraulic,seatbelt,walkaround,bucket,boom,track tension,operator,idle
INTERRUPTION_MIN_DURATION_SECONDS=0.4
FALSE_INTERRUPTION_TIMEOUT_SECONDS=1.5

# Brain stream limits
LLM_FIRST_CHUNK_TIMEOUT_SECONDS=6
LLM_STALL_TIMEOUT_SECONDS=5
LLM_MAX_ATTEMPTS=2
MAX_CONTEXT_TURNS=8

# Privacy / diagnostics
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false
RECORD_AUDIO=false
RECORD_AUDIO_DIR=recordings
RECORD_RETENTION_HOURS=24
METRICS_DIR=metrics
TTS_CACHE_DIR=.cache/tts

# Future-only: not required, instantiated, or contacted in this phase
# LANGGRAPH_BASE_URL=
# COCOON_SERVICE_TOKEN=
