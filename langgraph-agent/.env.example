# langgraph-agent settings. Copy to .env (same folder). Loaded from this folder regardless of cwd.

# Shared secret the voice worker sends as "Authorization: Bearer <token>". Use a long random value.
COCOON_SERVICE_TOKEN=dev-local-change-me

# Bind locally by default. Use 0.0.0.0 only behind a firewall/tunnel when another machine must reach it.
COCOON_HOST=127.0.0.1
COCOON_PORT=8000
COCOON_LOG_LEVEL=INFO
# SQLite files (cocoon.db, checkpoints.db) live here. Relative paths resolve against this folder.
COCOON_DATA_DIR=data

# mock = deterministic router/wording, no provider calls, no credentials needed.
# live = a real model. Live mode never falls back to mock: provider failures are retryable 503 llm_unavailable.
COCOON_LLM_MODE=mock
# Live provider: vertex (selected; Gemini on Vertex AI via Application Default Credentials) or anthropic (legacy).
COCOON_LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=orbit-507316
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# gemini-3.8-flash rejects "minimal"; low | medium | high | model_default
VERTEX_THINKING_LEVEL=low
VERTEX_MAX_OUTPUT_TOKENS=1024
# Optional: ADC file path, handed to the Google SDK as the standard GOOGLE_APPLICATION_CREDENTIALS variable.
# Leave unset to use gcloud's default ADC location. Never commit a credential file or copy it into this repo.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\application_default_credentials.json
COCOON_LLM_TIMEOUT_SECONDS=20
# Load bounds for live Vertex calls (per process). Retries cover 408/429/5xx/timeouts only, with jittered backoff
# (1-4 s, capped even if the provider suggests longer); the turn deadline below bounds all waiting.
VERTEX_MAX_ATTEMPTS=3
COCOON_LLM_MAX_CONCURRENCY=1
COCOON_LLM_MAX_WAITING=8
# template = one model call per turn (routing); the reply is worded from the saved action results.
# model = a second model call words the reply.
COCOON_LLM_COMPOSE=template
# Legacy provider only (COCOON_LLM_PROVIDER=anthropic):
ANTHROPIC_API_KEY=
COCOON_LLM_MODEL=claude-opus-5
COCOON_LLM_EFFORT=low
# "default" enables server-side refusal fallbacks (beta server-side-fallback-2026-07-01); "off" disables.
COCOON_LLM_FALLBACKS=default

# Verified machine/operator catalog (read-only). Relative paths resolve against langgraph-agent/, not the cwd.
# Absolute paths are allowed. Requests can never choose a path.
DATASET_ROOT=../Cocoon_Dataset_v1
# SHA-256 (lowercase hex) of the exact bytes of <DATASET_ROOT>/data/generated/manifest.json. Startup verifies it,
# then checks machines.csv/operators.csv against the digests listed in that manifest. A mismatch leaves the
# service not ready and refuses new sessions (503 catalog_unavailable); it never falls back to arbitrary IDs.
# Default = the provisional local development snapshot recorded on 2026-09-24 (not reviewed by the data owner).
DATASET_MANIFEST_SHA256=5d7de31c1856daf4179110a653d175891a102a53263356843792dd383f40e42d
# Optional server-controlled JSON (schema cocoon.session-bindings.v1) of trusted operator/machine/site/shift
# associations. Unset = no site/shift can be supplied (sessions get context_status "unavailable").
# SESSION_BINDINGS_PATH=data/demo/session_bindings.json   (written by scripts/seed_demo.py)

COCOON_TURN_TIMEOUT_SECONDS=45
COCOON_TURN_POLL_AFTER_MS=500
COCOON_ANNOUNCEMENT_TTL_SECONDS=120
# PROTOTYPE rule on simulated data: alert when seatbelt unfastened (and engine on, if true).
COCOON_SEATBELT_RULE_REQUIRES_ENGINE_ON=true
