        "kind",
        "payload"
      ],
      "title": "DeferAssignmentCommand",
      "type": "object"
    },
    "DeferAssignmentPayload": {
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Assignment Id",
          "type": "string"
        },
        "defer_until": {
          "description": "ISO-8601 UTC timestamp ending in Z; naive input is rejected.",
          "format": "date-time",
          "title": "Defer Until",
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "defer_until"
      ],
      "title": "DeferAssignmentPayload",
      "type": "object"
    },
