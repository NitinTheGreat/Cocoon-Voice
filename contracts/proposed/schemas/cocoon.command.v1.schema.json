{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cocoon:schema:cocoon.command.v1",
  "x-implementation-status": "proposed",
  "x-visibility": "public",
  "$defs": {
    "AlertAcknowledgeCommand": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cocoon.command.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "command_id": {
          "description": "Dedup key, unique per issuing subject across sessions/reconnects.",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Command Id",
          "type": "string"
        },
        "captured_at": {
          "description": "Device time when the operator acted.",
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "client_draft_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Draft Id"
        },
        "binding": {
          "$ref": "#/$defs/CommandBinding"
        },
        "expected_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of the target record the device last saw.",
          "title": "Expected Version"
        },
        "kind": {
          "const": "alert.acknowledge",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AlertAcknowledgePayload"
        }
      },
      "required": [
        "schema_version",
        "command_id",
        "captured_at",
        "binding",
        "kind",
        "payload"
      ],
      "title": "AlertAcknowledgeCommand",
      "type": "object"
    },
    "AlertAcknowledgePayload": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Alert Id",
          "type": "string"
        }
      },
      "required": [
        "alert_id"
      ],
      "title": "AlertAcknowledgePayload",
      "type": "object"
    },
    "CommandBinding": {
      "additionalProperties": false,
      "description": "The association captured on the device when the command was created. It must match server-authorised\ncontext; it grants no authority. A delayed upload keeps this original binding even if a newer session exists.",
      "properties": {
        "operator_id": {
          "examples": [
            "OP_DEMO_1_1"
          ],
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Operator Id",
          "type": "string"
        },
        "machine_id": {
          "description": "Exact catalog asset ID. Checked against the verified catalog when a session is created (since I02a); an unknown ID is rejected with 422 unknown_machine.",
          "examples": [
            "EXC_DEMO_001",
            "DOZ_DEMO_001",
            "LDR_DEMO_001",
            "TRK_DEMO_001",
            "BHL_DEMO_001"
          ],
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Machine Id",
          "type": "string"
        },
        "shift_id": {
          "examples": [
            "EXC_DEMO_001_2026-08-25"
          ],
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Shift Id",
          "type": "string"
        },
        "site_id": {
          "examples": [
            "SITE_FIXTURE_A"
          ],
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Site Id",
          "type": "string"
        },
        "device_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Device Id",
          "type": "string"
        },
        "session_id": {
          "description": "Session the command was captured in (may no longer be active).",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "machine_id",
        "shift_id",
        "site_id",
        "device_id",
        "session_id"
      ],
      "title": "CommandBinding",
      "type": "object"
    },
    "DeferAssignmentCommand": {
